# PostgreSQL (local defaults)
DATABASE_URL=postgresql://reah_user:reah_password@127.0.0.1:5432/reah_db
# For Aiven, set the project's PEM certificate and omit TLS parameters from DATABASE_URL.
DATABASE_CA_CERT=

# Compose database initialization and published port
POSTGRES_USER=reah_user
POSTGRES_PASSWORD=reah_password
POSTGRES_DB=reah_db
POSTGRES_PORT=5432

# Session — must be at least 32 random characters
SESSION_SECRET=change_me_to_a_random_32_char_string_here_please

# Vimeo API — get from https://developer.vimeo.com/apps
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="REAH <noreply@reah.fr>"

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Cron — set this in Vercel production environment variables
CRON_SECRET=
